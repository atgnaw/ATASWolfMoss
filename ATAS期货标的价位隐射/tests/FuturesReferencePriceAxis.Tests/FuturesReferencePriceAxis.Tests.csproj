<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="OptionFeatureTests.cs" />
    <Compile Include="..\..\src\FuturesReferencePriceAxis\Core\*.cs"
             Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\FuturesReferencePriceAxis.DealerHeatmap\Core\*.cs"
             Link="DealerHeatmapCore\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FuturesReferencePriceAxis\FuturesReferencePriceAxis.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\FuturesReferencePriceAxis.DealerHeatmap\FuturesReferencePriceAxis.DealerHeatmap.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
