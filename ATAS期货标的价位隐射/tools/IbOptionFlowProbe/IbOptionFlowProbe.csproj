    <None Update="probe.example.json;Start-Probe.ps1;Start-Probe.cmd;README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../shared/WolfMoss.IB/WolfMoss.IB.props" />
</Project>
