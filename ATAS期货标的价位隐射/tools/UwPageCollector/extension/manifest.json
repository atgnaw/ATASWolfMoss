{
  "manifest_version": 3,
  "name": "UW 页面采集助手",
  "version": "0.1.4",
  "description": "只读取已登录的 Interval Flow 页面，保存可追溯快照与经校验的 B/A 数量。",
  "host_permissions": ["https://unusualwhales.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "打开 UW 采集控制台" },
  "content_scripts": [{
    "matches": ["https://unusualwhales.com/interval-flow*"],
    "js": ["core.js", "reader.js", "content.js"],
    "run_at": "document_idle"
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'" }
}
